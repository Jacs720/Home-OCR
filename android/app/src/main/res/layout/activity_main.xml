<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_logo"
                    android:contentDescription="@string/app_icon_description"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/app_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hero_subtitle"
                        android:textColor="@color/hero_secondary_text"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_status"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:text="@string/loading_model"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="24dp"
            android:text="@string/preview_title" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="6dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_preview"
                android:contentDescription="@string/preview_description"
                android:padding="54dp"
                android:scaleType="centerInside"
                android:src="@drawable/app_logo" />
        </FrameLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="24dp"
            android:text="@string/session_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/session_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/scan_limit_label"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/scan_limit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/scan_limit"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/default_scan_limit"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/auto_swipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/checkbox_tint"
                android:checked="true"
                android:minHeight="48dp"
                android:text="@string/auto_swipe"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/prepare_automation"
                style="@style/SecondaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/prepare_automation" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/automation_explanation"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="24dp"
            android:text="@string/actions_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/start_floating_capture"
                style="@style/PrimaryButton"
                android:text="@string/start_floating_capture" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/select_images"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="@string/select_images" />

                <Button
                    android:id="@+id/scan_images"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/scan_images" />
            </LinearLayout>

            <Button
                android:id="@+id/export_csv"
                style="@style/GhostButton"
                android:layout_marginTop="10dp"
                android:text="@string/export_csv" />

            <Button
                android:id="@+id/open_checklist"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="@string/open_checklist" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progressBackgroundTint="@color/progress_track"
                android:progressTint="@color/brand_yellow"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/SectionTitle"
            android:layout_marginTop="24dp"
            android:text="@string/collection_title" />

        <TextView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:lineSpacingExtra="4dp"
            android:minHeight="112dp"
            android:padding="16dp"
            android:text="@string/collection_empty"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
